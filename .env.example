# Browser-safe Supabase credentials. The anon key is protected by RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-hosted-anon-key

# Optional URL used in owner invitation and password-reset emails.
VITE_SITE_URL=http://localhost:4173

# Optional for local AI menu imports. Vercel deployments authenticate to
# AI Gateway automatically with VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=replace-with-local-ai-gateway-key
AI_MENU_MODEL=google/gemini-3-flash
AI_MENU_MODEL=google/gemini-3-flash
